{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "build/",
    ".react-router/",
    "drizzle/",
    "package-lock.json",
    "skills-lock.json",
    ".claude/",
    ".agents/",
    ".sandcastle/",
    "_internal/",
    "request-logger/logs/",
    "*.db",
    "oxlint-baseline.json",
    "file-token-baseline.json"
  ]
}
